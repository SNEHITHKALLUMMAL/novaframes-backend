{
  "name": "ai-video-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express REST API for the AI Video Generation Platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node --watch src/workers/generation.worker.js",
    "seed:mock-model": "node scripts/seed-mock-model.js",
    "seed:wan-model": "node scripts/seed-wan-model.js",
    "seed:replicate-wan-model": "node scripts/seed-replicate-wan-model.js",
    "recover:orphaned-jobs": "node scripts/recover-orphaned-jobs.js",
    "lint": "eslint src",
    "test": "node --test"
