# Generation worker image — same codebase as the API (server/Dockerfile),
# run via `npm run worker` instead of `npm start`, and with ffmpeg
# installed since every adapter (DevelopmentMockAdapter today, WanAdapter
# once enabled) shells out to a real ffmpeg binary for post-processing
# (see src/utils/ffmpeg.js). Deliberately still Node-only, no CUDA/Python —
# this image runs the mock adapter fine, but a real GPU-backed Wan worker
# needs the heavier CUDA + Python image built in PHASE_23, which this is
# not a substitute for.

FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --omit=dev

FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# ffmpeg: required at runtime by every adapter's post-processing step.
# procps: gives us `pgrep`, used by the HEALTHCHECK below — this is a
# single long-running process with no HTTP endpoint to probe, so
# "is the worker process still running" is the simplest meaningful check.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg procps \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --home /app app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
COPY scripts ./scripts
RUN mkdir -p /app/storage && chown -R app:app /app
USER app

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD pgrep -f "generation.worker.js" || exit 1

CMD ["node", "src/workers/generation.worker.js"]
